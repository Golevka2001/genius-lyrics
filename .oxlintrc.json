{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"browser": true,
		"es2024": true
	},
	"ignorePatterns": ["dist", "node_modules", "**/classmap.d.ts"],
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none"
			}
		],
		"no-this-alias": "warn",
		"no-useless-escape": "warn",
		"no-undef": "error",
		"typescript/ban-ts-comment": [
			"error",
			{
				"ts-nocheck": true,
				"ts-ignore": false,
				"ts-expect-error": false,
				"ts-check": false
			}
		]
	}
}
